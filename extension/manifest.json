{
  "manifest_version": 3,
  "name": "Razer Battery Monitor",
  "description": "Batterie Razer (souris, clavier, casque) via WebHID — zéro backend",
  "version": "1.0.0",
  "permissions": ["hid", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Razer Battery",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
