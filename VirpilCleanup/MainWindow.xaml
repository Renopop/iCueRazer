&lt;Window x:Class="VirpilCleanup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VIRPIL USB Device Cleaner" Height="500" Width="700"
        Background="#F5F5F5" FontFamily="Segoe UI" FontSize="12"
        WindowStartupLocation="CenterScreen"
        Icon="data:image/x-icon;base64,
"
        WindowStyle="SingleBorderWindow">
    <Grid Background="#F5F5F5">
        <StackPanel Margin="20" Orientation="Vertical" Spacing="15">
            <TextBlock Text="VIRPIL USB Device Cleaner" FontSize="18" FontWeight="Bold" Foreground="#333"/>
            <TextBlock Text="Détecte et supprime les périphériques USB VIRPIL pour les réinstaller proprement."
                       FontSize="12" Foreground="#666" TextWrapping="Wrap"/>

            <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto" Height="350">
                <TextBox x:Name="LogTextBox"
                         Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         Background="White"
                         Foreground="#333"
                         FontFamily="Consolas"
                         FontSize="11"
                         VerticalScrollBarVisibility="Auto"
                         Padding="10"
                         BorderThickness="1"
                         BorderBrush="#DDD"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button x:Name="RefreshButton"
                        Click="LoadDevices"
                        Padding="15,8"
                        Background="#4CAF50"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand">
                    🔄 Actualiser
                </Button>
                <Button x:Name="RemoveButton"
                        Click="RemoveDevices"
                        Padding="15,8"
                        Background="#F44336"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand">
                    🗑️ Supprimer les périphériques
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
