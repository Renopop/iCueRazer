<Window x:Class="VirpilCleanup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VIRPIL USB Device Cleaner"
        Height="520" Width="700"
        MinHeight="400" MinWidth="500"
        Background="#F0F0F0"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="VIRPIL USB Device Cleaner"
                       FontSize="20" FontWeight="Bold" Foreground="#1A1A2E"/>
            <TextBlock Text="Supprime les périphériques VIRPIL du système et du registre Windows pour une réinstallation propre."
                       FontSize="12" Foreground="#555" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Warning bar -->
        <Border Grid.Row="1" Background="#FFF3CD" BorderBrush="#FFEAA7" BorderThickness="1"
                CornerRadius="4" Padding="10,6" Margin="0,0,0,12">
            <TextBlock Text="⚠  Nécessite des droits administrateur. Redémarrez le PC après le nettoyage."
                       Foreground="#856404" FontSize="11" TextWrapping="Wrap"/>
        </Border>

        <!-- Log area -->
        <Border Grid.Row="2" Background="White" BorderBrush="#CCC" BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="LogTextBox"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         Background="Transparent"
                         Foreground="#222"
                         FontFamily="Consolas"
                         FontSize="11"
                         BorderThickness="0"
                         Padding="10"
                         AcceptsReturn="True"/>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="RefreshButton"
                    Content="Actualiser"
                    Click="LoadDevices_Click"
                    Padding="16,8" Margin="0,0,8,0"
                    Background="#4CAF50" Foreground="White"
                    FontWeight="SemiBold" Cursor="Hand"
                    BorderThickness="0"/>
            <Button x:Name="RemoveButton"
                    Content="Supprimer les périphériques VIRPIL"
                    Click="RemoveDevices_Click"
                    Padding="16,8"
                    Background="#E53935" Foreground="White"
                    FontWeight="SemiBold" Cursor="Hand"
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
